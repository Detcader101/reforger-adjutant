# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: comma-separated guild ids to sync slash commands to instantly
# (leave empty for global sync, which can take up to an hour to propagate)
DEV_GUILD_IDS=

# Optional: sqlite path override (default: data/adjutant.db)
ADJUTANT_DB=

# Stamped by the deploy timer in production — leave alone locally
BOT_GIT_SHA=
BOT_GIT_SUBJECT=
